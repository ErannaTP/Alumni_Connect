# Environment Variables
NODE_ENV=development
PORT=5000

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/kle-alumni-connect

# JWT Secret
JWT_SECRET=kle_alumni_connect_secret_key_2024_change_in_production

# JWT Expiration
JWT_EXPIRE=7d

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Frontend URL
CLIENT_URL=http://localhost:8080

# File Upload
MAX_FILE_SIZE=5242880
